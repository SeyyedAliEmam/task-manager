@using MemberShip.Web.ViewModels.SendEmail
@model VerifyOTPViewModel
 
@{
    ViewData["Title"] = "تایید کد ارسال شده";
}

<h1>تایید کد ارسال شده</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="VerifyOTP" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="OTPInput" class="control-label"></label>
                <input asp-for="OTPInput" class="form-control"/>
                <span asp-validation-for="OTPInput" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ورود" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}